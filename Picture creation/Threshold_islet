import numpy as np
import cv2
import matplotlib.pyplot as plt
import matplotlib.patches as patches

# Parameters
height, width = 256, 256
center = np.array([width // 2, height // 2])
axes = np.array([60, 45])
angle = 90
num_points = 50
noise_amplitude = 2
gauss_noise_std = 10  # noise stddev on image intensity
threshold_value = 100  # threshold on grayscale (0-255)

# 1. Create rough elliptical contour points
theta = np.linspace(0, 2*np.pi, num_points)
noise = np.random.normal(0, noise_amplitude, num_points)
x = axes[0] * np.cos(theta)
y = axes[1] * np.sin(theta)
radii = np.sqrt(x**2 + y**2)
radii_noisy = radii + noise
radii_noisy = np.clip(radii_noisy, axes.min()*0.5, axes.max()*1.5)
x_noisy = radii_noisy * np.cos(theta)
y_noisy = radii_noisy * np.sin(theta)
pts = np.vstack((x_noisy, y_noisy)).T
if angle != 0:
    rad = np.deg2rad(angle)
    R = np.array([[np.cos(rad), -np.sin(rad)],
                  [np.sin(rad),  np.cos(rad)]])
    pts = pts @ R.T
pts += center
pts = np.round(pts).astype(np.int32).reshape((-1, 1, 2))

# 2. Create blank grayscale image with dark background
img_gray = np.zeros((height, width), dtype=np.uint8) + 50  # dark gray background

# 3. Fill the islet shape with a brighter intensity
cv2.fillPoly(img_gray, [pts], 180)

# 4. Add Gaussian noise to the grayscale image
noise_img = np.random.normal(0, gauss_noise_std, (height, width)).astype(np.int16)
img_noisy = img_gray.astype(np.int16) + noise_img
img_noisy = np.clip(img_noisy, 0, 255).astype(np.uint8)

# 5. Threshold the noisy image
_, img_segmented = cv2.threshold(img_noisy, threshold_value, 255, cv2.THRESH_BINARY)

# Plotting
fig, axes = plt.subplots(1, 3, figsize=(15, 5))

# a) Grayscale noisy image
axes[0].imshow(img_noisy, cmap='gray')
axes[0].set_title('Grayscale Islet (Noisy)')
axes[0].axis('off')
axes[0].text(-0.1, 1.05, 'A', transform=axes[0].transAxes,
             fontsize=16, fontweight='bold', va='bottom', ha='right')

# b) Histogram with threshold line
axes[1].hist(img_noisy.ravel(), bins=256, color='gray')
axes[1].axvline(threshold_value, color='red', linestyle='--', label=f'Threshold = {threshold_value}')
axes[1].set_title('Pixel Intensity Histogram')
axes[1].set_xlabel('Pixel Intensity')
axes[1].set_ylabel('Frequency')
axes[1].legend()
axes[1].text(-0.1, 1.05, 'B', transform=axes[1].transAxes,
             fontsize=16, fontweight='bold', va='bottom', ha='right')

# c) Segmentation result
axes[2].imshow(img_segmented, cmap='gray')
axes[2].set_title('Segmented Islet')
axes[2].axis('off')
axes[2].text(-0.1, 1.05, 'C', transform=axes[2].transAxes,
             fontsize=16, fontweight='bold', va='bottom', ha='right')

plt.tight_layout()

fig.canvas.draw()  # Update figure to get correct subplot positions

# Get bounding boxes in figure coordinates
bbox0 = axes[0].get_position()
bbox1 = axes[1].get_position()
bbox2 = axes[2].get_position()

# Calculate arrow start/end positions (center vertical of each subplot)
fig_x0 = bbox0.x1
fig_y0 = bbox0.y0 + bbox0.height / 2
fig_x1 = bbox1.x0
fig_y1 = bbox1.y0 + bbox1.height / 2

fig_x2 = bbox1.x1
fig_y2 = bbox1.y0 + bbox1.height / 2
fig_x3 = bbox2.x0
fig_y3 = bbox2.y0 + bbox2.height / 2

# Create arrow patches
arrow1 = patches.FancyArrowPatch((fig_x0, fig_y0), (fig_x1, fig_y1),
                                 transform=fig.transFigure,
                                 arrowstyle='->', mutation_scale=20,
                                 color='black', linewidth=2)
arrow2 = patches.FancyArrowPatch((fig_x2, fig_y2), (fig_x3, fig_y3),
                                 transform=fig.transFigure,
                                 arrowstyle='->', mutation_scale=20,
                                 color='black', linewidth=2)

fig.add_artist(arrow1)
fig.add_artist(arrow2)

plt.show()

import os
output_folder = "images"
os.makedirs(output_folder, exist_ok=True)
output_path = os.path.join(output_folder, "islet_threshold_visualization.png")
fig.savefig(output_path, dpi=300, bbox_inches='tight')
print(f"Saved figure to {output_path}")

plt.show()
