import numpy as np
import matplotlib.pyplot as plt
import matplotlib.patches as patches

# Define matrices
input_matrix = np.round(np.random.rand(6, 6) * 9).astype(int)
filter_matrix = np.array([[1, 0, -1],
                          [1, 0, -1],
                          [1, 0, -1]])  # Example filter (Sobel)

# Perform convolution manually (valid padding, stride 1)
output_matrix = np.zeros((4, 4), dtype=int)
for i in range(4):
    for j in range(4):
        region = input_matrix[i:i+3, j:j+3]
        output_matrix[i, j] = np.sum(region * filter_matrix)

# --- Plotting ---
fig = plt.figure(figsize=(14, 5))

# A. Input matrix with top-left filter overlay
ax1 = fig.add_subplot(1, 3, 1)
ax1.imshow(input_matrix, cmap='Blues', vmin=0, vmax=9)
ax1.set_title("A. Input Matrix")

# Add grid values
for i in range(6):
    for j in range(6):
        ax1.text(j, i, str(input_matrix[i, j]), ha='center', va='center', color='black')

# Draw 3×3 filter overlay at top-left corner
rect = patches.Rectangle((0 - 0.5, 0 - 0.5), 3, 3,
                         linewidth=5, edgecolor='orange', facecolor='orange', alpha=0.25)
ax1.add_patch(rect)

# Label under filter overlay
ax1.text(1, 1, 'Filter (B)', ha='center', va='center',
         fontsize=10, fontweight='bold', color='orange')

ax1.text(-0.1, 1.05, 'A', transform=ax1.transAxes,
         fontsize=16, fontweight='bold', va='bottom', ha='right')

# B. Filter matrix separately
ax2 = fig.add_subplot(1, 3, 2)
ax2.imshow(filter_matrix, cmap='Blues')
ax2.set_title("B. Filter")
for i in range(3):
    for j in range(3):
        ax2.text(j, i, str(filter_matrix[i, j]), ha='center', va='center', color='black')
ax2.text(-0.1, 1.05, 'B', transform=ax2.transAxes,
         fontsize=16, fontweight='bold', va='bottom', ha='right')

# C. Output matrix
ax3 = fig.add_subplot(1, 3, 3)
ax3.imshow(output_matrix, cmap='Blues')
ax3.set_title("C. Output Matrix (Convolution Result)")
for i in range(4):
    for j in range(4):
        ax3.text(j, i, str(output_matrix[i, j]), ha='center', va='center', color='black')
ax3.text(-0.1, 1.05, 'C', transform=ax3.transAxes,
         fontsize=16, fontweight='bold', va='bottom', ha='right')

# Final layout
for ax in [ax1, ax2, ax3]:
    ax.set_xticks([])
    ax.set_yticks([])

plt.tight_layout()
plt.show()
